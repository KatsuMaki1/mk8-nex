# Mario Kart 8 (Wii U) - NEX server config.
# Copy to .env and fill in. All names are namespaced PN_MK8_*.

# --- PRUDP listeners ---
PN_MK8_AUTH_PORT=29500
PN_MK8_SECURE_PORT=29501
# Host the client is told to reach the secure server on. MUST be short: the
# retail binary truncates it into a ~15-char buffer.
PN_MK8_SECURE_HOST=localhost

# --- Database (ranking + DataStore + matchmaking, one database) ---
PN_MK8_POSTGRES_URI=postgres://mk8:mk8@localhost:5432/mk8?sslmode=disable

# --- Kerberos / system accounts ---
PN_MK8_KERBEROS_PASSWORD=change-me

# --- Auth mode ----------------------------------------------------------
# 1 = isolated preservation mode: accounts from settings.json, login token
#     not validated. Leave the two NEX_* vars below empty.
PN_MK8_LOCAL_MODE=1
PN_MK8_SETTINGS_PATH=settings.json

# Required only when PN_MK8_LOCAL_MODE is not 1:
PN_MK8_NEX_TOKEN_AES_KEY=
PN_MK8_NEX_PASSWORD_SECRET=

# --- Optional: DataStore object uploads -----
# Only needed if players PUBLISH objects. Downloading works without S3.
PN_S3_ENDPOINT=
PN_S3_ACCESS_KEY=
PN_S3_SECRET_KEY=
PN_S3_BUCKET=mk8-datastore
